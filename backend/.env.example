# Copy this file to .env and replace the placeholder values.
# Never commit real secrets to the repository.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=replace-with-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Windows/macOS/Linux host connection to the PostgreSQL service in docker-compose.yml.
LOCAL_DATABASE_URL=postgresql://mahir_user:mahir_pass@localhost:5432/mahir_showroom
# Render production uses DATABASE_URL set to the Neon direct connection string.

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sales-and-stock-management-s7d7.vercel.app

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
GROQ_API_KEY=replace-with-your-groq-key
# Free-tier Groq option recommended for Bangla/Banglish/English queries:
GROQ_MODEL=llama-3.1-8b-instant
